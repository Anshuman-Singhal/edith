{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edith.local/schemas/v1/sys.pong.schema.json",
  "title": "sys.pong",
  "description": "Echoes t0_ms; t1_ms = responder receive, t2_ms = responder send (responder clock).",
  "type": "object",
  "required": [
    "t0_ms",
    "t1_ms",
    "t2_ms"
  ],
  "properties": {
    "t0_ms": {
      "type": "integer",
      "minimum": 0
    },
    "t1_ms": {
      "type": "integer",
      "minimum": 0
    },
    "t2_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
