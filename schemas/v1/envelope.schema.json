{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edith.local/schemas/v1/envelope.schema.json",
  "title": "Envelope",
  "description": "interfaces §2. `body` is validated against the schema of `type` (index.json).",
  "type": "object",
  "required": [
    "v",
    "type",
    "id",
    "ts_ms",
    "src",
    "seq",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z_]+)+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ts_ms": {
      "$ref": "defs.schema.json#/$defs/TsMs"
    },
    "src": {
      "$ref": "defs.schema.json#/$defs/Id"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "body": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
