{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edith.local/schemas/v1/defs.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "TsMs": {
      "type": "integer",
      "minimum": 0,
      "description": "ScaledClock epoch ms (C94)"
    },
    "DurMs": {
      "type": "integer",
      "minimum": 0
    },
    "Lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "Lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "Deg360": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360,
      "description": "degrees true, clockwise from north"
    },
    "Conf": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ConfOrNull": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "Pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "CeM": {
      "type": "number",
      "minimum": 0,
      "description": "CE90 radius, metres (C57)"
    },
    "Mgrs": {
      "type": "string",
      "pattern": "^[0-9]{1,2}[C-HJ-NP-X][A-HJ-NP-Z]{2}([0-9]{2}){0,5}$",
      "description": "MGRS without spaces, e.g. 16TCK6100236799"
    },
    "LatLon": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "$ref": "#/$defs/Lat"
        },
        "lon": {
          "$ref": "#/$defs/Lon"
        }
      },
      "additionalProperties": true
    },
    "Pos": {
      "type": "object",
      "required": [
        "lat",
        "lon",
        "alt_msl_m",
        "alt_agl_m"
      ],
      "properties": {
        "lat": {
          "$ref": "#/$defs/Lat"
        },
        "lon": {
          "$ref": "#/$defs/Lon"
        },
        "alt_msl_m": {
          "type": "number"
        },
        "alt_agl_m": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "Att": {
      "type": "object",
      "required": [
        "roll_deg",
        "pitch_deg",
        "yaw_deg"
      ],
      "properties": {
        "roll_deg": {
          "type": "number"
        },
        "pitch_deg": {
          "type": "number"
        },
        "yaw_deg": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "BboxNorm": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "[x, y, w, h], normalised 0..1, origin top-left"
    },
    "Cls": {
      "type": "string",
      "enum": [
        "person",
        "vehicle",
        "other"
      ]
    },
    "Tier": {
      "type": "string",
      "enum": [
        "advisory",
        "caution",
        "warning"
      ]
    },
    "LinkState": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "lost"
      ]
    },
    "Affiliation": {
      "type": "string",
      "enum": [
        "unknown",
        "friend",
        "neutral",
        "hostile"
      ]
    },
    "Verb": {
      "type": "string",
      "enum": [
        "takeoff",
        "goto",
        "orbit",
        "observe",
        "search",
        "follow",
        "hold",
        "rtl",
        "land"
      ]
    },
    "ConfirmWith": {
      "type": "string",
      "enum": [
        "voice",
        "touch_temple",
        "touch_companion"
      ]
    },
    "AlertAction": {
      "type": "string",
      "enum": [
        "watch",
        "mark",
        "dismiss",
        "say_again",
        "details"
      ]
    },
    "AlertLabel": {
      "type": "string",
      "pattern": "^(PERSON|VEHICLE|GEOFENCE|TEAMMATE|TAK LINK|D[1-9] (LINK|BATT|TASK)|[1-9][0-9]? NEW)$",
      "description": "enum PERSON|VEHICLE|GEOFENCE|TEAMMATE|D<n> LINK|TAK LINK|D<n> BATT|D<n> TASK|<n> NEW (C102)"
    }
  }
}
