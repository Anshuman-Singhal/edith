#!/usr/bin/env bash
# E.D.I.T.H. developer CLI shim (WS-A). Everything goes through the uv workspace.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
if ! command -v uv >/dev/null 2>&1; then
  echo "edith: 'uv' not found. Install it: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
  exit 127
fi
exec uv run --quiet --project "$ROOT" python -m edith_tools.cli "$@"
