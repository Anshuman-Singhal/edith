{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edith.local/schemas/bringup/results.schema.json",
  "title": "E.D.I.T.H. selftest APK results (edith.bringup.results/v1)",
  "description": "Written by SelfTestActivity to /sdcard/Android/data/edith.selftest/files/results/<run_id>/results.json and rewritten after every test. Pulled by tools/bringup.sh.",
  "type": "object",
  "required": ["schema", "run_id", "created_at", "updated_at", "app", "device", "display", "provisioning", "tests"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "edith.bringup.results/v1" },
    "run_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$" },
    "created_at": { "$ref": "#/$defs/iso" },
    "updated_at": { "$ref": "#/$defs/iso" },
    "app": {
      "type": "object",
      "required": ["package", "flavor", "version_name", "version_code", "platform"],
      "properties": {
        "package": { "type": "string" },
        "flavor": { "enum": ["rayneo", "generic", "jvm-test"] },
        "version_name": { "type": "string" },
        "version_code": { "type": "integer" },
        "platform": { "type": "string" },
        "git": { "type": ["string", "null"] }
      }
    },
    "device": {
      "description": "Build identity (T0, in-app view): Build.* and selected system properties.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "display": {
      "description": "What the APK found at runtime (T5). Device display mode is UNVERIFIED until T5.",
      "type": "object"
    },
    "provisioning": {
      "type": "object",
      "properties": {
        "peer": { "type": ["string", "null"] },
        "token_set": { "type": "boolean" }
      }
    },
    "tests": {
      "type": "object",
      "propertyNames": { "pattern": "^T([0-9]|1[0-8])$" },
      "additionalProperties": { "$ref": "#/$defs/test" }
    }
  },
  "$defs": {
    "iso": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "test": {
      "type": "object",
      "required": ["id", "name", "status", "started_at", "ended_at", "metrics", "errors", "operator"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^T([0-9]|1[0-8])$" },
        "name": { "type": "string" },
        "status": {
          "description": "pass/fail: decided by the APK from TESTS.md thresholds. measured: values recorded, a human decides (or the run must be longer). incomplete: still running or abandoned.",
          "enum": ["pass", "fail", "measured", "incomplete", "error", "skipped", "not_implemented"]
        },
        "started_at": { "$ref": "#/$defs/iso" },
        "ended_at": { "oneOf": [{ "$ref": "#/$defs/iso" }, { "type": "null" }] },
        "pass_criterion": { "type": ["string", "null"] },
        "metrics": { "type": "object" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "operator": { "description": "Operator answers given on the glasses (e.g. T5 fused: yes/no).", "type": "object" }
      }
    }
  }
}
